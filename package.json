{
  "name": "personal-portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "test:visual": "npx playwright test --project=visual",
    "test:a11y": "npx playwright test --project=a11y",
    "test:visual:update": "npx playwright test --project=visual --update-snapshots"
  },
  "dependencies": {
    "next": "15.3.9",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "typescript": "5.7.3",
    "vitest": "3.1.3",
    "tailwindcss": "4.1.8",
    "@tailwindcss/postcss": "4.1.8",
    "postcss": "8.5.4",
    "@playwright/test": "^1.50.0",
    "@axe-core/playwright": "^4.10.0"
  }
}
