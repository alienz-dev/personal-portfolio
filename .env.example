# Personal info (required)
NEXT_PUBLIC_FULL_NAME="Your Full Name"
NEXT_PUBLIC_DISPLAY_NAME="YourName"
NEXT_PUBLIC_EMAIL="you@example.com"
NEXT_PUBLIC_LINKEDIN="https://linkedin.com/in/yourprofile"
NEXT_PUBLIC_GITHUB="https://github.com/yourusername"
NEXT_PUBLIC_GITHUB_ORG="your-org"
NEXT_PUBLIC_DOMAIN="yourdomain.com"

# Positioning
NEXT_PUBLIC_TITLE="Building tools that make AI actually work for developers"
NEXT_PUBLIC_KEYWORDS="TypeScript,Node.js,AI Agents,Developer Tooling"

# Now section
NEXT_PUBLIC_NOW_DESCRIPTION="Building a knowledge management system to power business in the agentic era."

# AI
DEEPSEEK_API_KEY="your-deepseek-api-key"

# Rate limiting (Upstash Redis)
UPSTASH_REDIS_REST_URL="https://your-redis-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-redis-token"

# Jobs dashboard login. Unset means the dashboard denies everyone.
# Next inlines these into the Edge bundle at build time, so they must be set
# wherever `vercel build` runs — for this project, on the machine that builds.
JOBS_USERNAME=""
JOBS_PASSWORD=""
# Optional: comma-separated addresses that skip the login form.
JOBS_ALLOWED_IPS=""
